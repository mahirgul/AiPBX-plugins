{
    "slug": "cnam",
    "name": "Caller Name (CNAM)",
    "name_i18n": {
        "en": "Caller Name (CNAM)",
        "tr": "Arayan Adı (CNAM)"
    },
    "version": "1.1.1",
    "requires_aipbx": "1.72.12",
    "author": "AiPBX community",
    "author_url": "https://github.com/mahirgul/AiPBX-plugins/tree/main/plugins/community/cnam",
    "type": "community",
    "category": "integration",
    "icon": "fas fa-id-card",
    "icon_style": "color: #0284c7;",
    "description": "Caller ID name lookup for inbound calls: checks active extensions & SMS contacts, then queries BulkVS, Telnyx, Twilio, Vonage, OpenCNAM, SignalWire, NumVerify, AbstractAPI or custom URL with local caching to reduce costs.",
    "description_i18n": {
        "en": "Caller ID name lookup for inbound calls: checks active extensions & SMS contacts, then queries BulkVS, Telnyx, Twilio, Vonage, OpenCNAM, SignalWire, NumVerify, AbstractAPI or custom URL with local caching to reduce costs.",
        "tr": "Gelen aramalarda arayan adı sorgulaması: önce dahili rehberi kontrol eder, ardından BulkVS, Telnyx, Twilio, Vonage, OpenCNAM, SignalWire, NumVerify, AbstractAPI veya özel URL ile sorgulayıp maliyeti düşürmek için önbelleğe alır."
    },
    "tables": [
        "plg_cnam_cache"
    ],
    "scopes": [],
    "hooks": {
        "public_endpoints": true,
        "sync_domain": "general_dialplan",
        "admin_page": {
            "group": "integrations"
        }
    },
    "settings_schema": [
        {
            "key": "provider",
            "type": "select",
            "default": "bulkvs",
            "label": "CNAM Provider",
            "options": {
                "bulkvs": "BulkVS",
                "telnyx": "Telnyx (Number Lookup)",
                "twilio": "Twilio (Lookup v2)",
                "vonage": "Vonage (Number Insight)",
                "opencnam": "OpenCNAM",
                "signalwire": "SignalWire",
                "numverify": "NumVerify (APILayer)",
                "abstractapi": "AbstractAPI",
                "custom": "Custom URL",
                "phonebook_only": "Local Phonebook Only (Free)"
            }
        },
        {
            "key": "cache_days",
            "type": "number",
            "default": "30",
            "label": "Cache Duration (Days, 0 = no cache)"
        },
        {
            "key": "overwrite_existing",
            "type": "boolean",
            "default": "0",
            "label": "Overwrite name even if already provided by carrier / trunk"
        },
        {
            "key": "check_phonebook",
            "type": "boolean",
            "default": "1",
            "label": "Check local extensions & contacts before paid provider"
        },
        {
            "key": "bulkvs_api_key",
            "type": "password",
            "default": "",
            "label": "BulkVS: API Key / ID",
            "secret": true
        },
        {
            "key": "bulkvs_endpoint",
            "type": "text",
            "default": "https://cnam.bulkvs.com/",
            "label": "BulkVS: Endpoint URL"
        },
        {
            "key": "telnyx_api_key",
            "type": "password",
            "default": "",
            "label": "Telnyx: API Key (Bearer)",
            "secret": true
        },
        {
            "key": "twilio_account_sid",
            "type": "text",
            "default": "",
            "label": "Twilio: Account SID"
        },
        {
            "key": "twilio_auth_token",
            "type": "password",
            "default": "",
            "label": "Twilio: Auth Token",
            "secret": true
        },
        {
            "key": "vonage_api_key",
            "type": "text",
            "default": "",
            "label": "Vonage: API Key"
        },
        {
            "key": "vonage_api_secret",
            "type": "password",
            "default": "",
            "label": "Vonage: API Secret",
            "secret": true
        },
        {
            "key": "opencnam_account_sid",
            "type": "text",
            "default": "",
            "label": "OpenCNAM: Account SID"
        },
        {
            "key": "opencnam_auth_token",
            "type": "password",
            "default": "",
            "label": "OpenCNAM: Auth Token",
            "secret": true
        },
        {
            "key": "signalwire_space",
            "type": "text",
            "default": "",
            "label": "SignalWire: Space URL (e.g. example.signalwire.com)"
        },
        {
            "key": "signalwire_project_id",
            "type": "text",
            "default": "",
            "label": "SignalWire: Project ID"
        },
        {
            "key": "signalwire_token",
            "type": "password",
            "default": "",
            "label": "SignalWire: API Token",
            "secret": true
        },
        {
            "key": "numverify_access_key",
            "type": "password",
            "default": "",
            "label": "NumVerify: Access Key (APILayer)",
            "secret": true
        },
        {
            "key": "abstractapi_api_key",
            "type": "password",
            "default": "",
            "label": "AbstractAPI: API Key",
            "secret": true
        },
        {
            "key": "custom_url",
            "type": "text",
            "default": "",
            "label": "Custom URL (use {number} or will append ?num=...)"
        }
    ]
}
